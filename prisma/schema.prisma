// Hisab Pro - Nepal Accounting Software
// Comprehensive Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ORGANIZATION & MULTI-TENANCY
// ============================================================

model Organization {
  id            String   @id @default(cuid())
  name          String
  nameNepali    String?
  panNumber     String?   // PAN/VAT number for IRD compliance
  address       String?
  city          String?
  province      String?
  phone         String?
  email         String?
  logo          String?
  fiscalYear    String?   // Current fiscal year e.g. "2081/82"
  currency      String    @default("NPR")
  vatEnabled    Boolean   @default(false)
  vatNumber     String?
  tdsEnabled    Boolean   @default(false)
  ssfEnabled    Boolean   @default(false)
  mode          String    @default("simple")  // "simple" or "advanced"
  industry      String?   // e.g. "trading", "manufacturing", "service"
  language      String    @default("en")  // "en", "ne", "hi", etc.

  // Subscription
  plan          String    @default("free") // "free", "pro", "enterprise"
  subscriptionStatus String @default("active") // "active", "past_due", "cancelled", "trialing"
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  trialEndsAt       DateTime?

  // IRD & CBMS Configuration
  cbmsEnabled   Boolean  @default(false)
  cbmsUrl       String   @default("https://cbapi.ird.gov.np/api/bill")
  cbmsReturnUrl String   @default("https://cbapi.ird.gov.np/api/billreturn")
  cbmsUsername  String?
  cbmsPassword  String?
  cbmsIsSandbox Boolean  @default(true)
  irdSoftwareCode String @default("HISABPRO-2081")
  invoicePrefix String   @default("INV")
  creditNotePrefix String @default("CN")

  // Relations
  users         UserOrganization[]
  accounts      Account[]
  accountGroups AccountGroup[]
  journalEntries JournalEntry[]
  parties       Party[]
  products      Product[]
  warehouses    Warehouse[]
  invoices      Invoice[]
  purchaseBills PurchaseBill[]
  creditNotes   CreditNote[]
  cbmsLogs      CbmsSyncLog[]
  taxRates      TaxRate[]
  auditLogs     AuditLog[]
  settings      OrganizationSetting[]
  fiscalYears   FiscalYear[]
  subscription  Subscription?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FiscalYear {
  id             String   @id @default(cuid())
  organizationId String
  name           String   // e.g. "2081/82"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  isLocked       Boolean  @default(false)

  organization   Organization @relation(fields: [organizationId], references: [id])
  journalEntries JournalEntry[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model OrganizationSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          String   // JSON string for complex values

  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

// ============================================================
// USER & AUTHORIZATION
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  nameNepali    String?
  phone         String?
  avatar        String?
  passwordHash  String?
  role          String   @default("user") // "super_admin", "user"
  language      String   @default("en")  // "en", "ne", "hi", etc.
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?

  organizations UserOrganization[]
  auditLogs     AuditLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id             String   @id @default(cuid())
  organizationId String   @unique
  plan           String   @default("free") // "free", "pro", "enterprise"
  status         String   @default("active") // "active", "past_due", "cancelled", "trialing"
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelledAt        DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("staff") // "admin", "accountant", "staff", "viewer"

  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

// ============================================================
// CHART OF ACCOUNTS
// ============================================================

model AccountGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  nameNepali     String?
  code           String   // e.g. "1", "11", "1100"
  parentGroupId  String?
  nature         String   // "asset", "liability", "equity", "income", "expense"
  isSystem       Boolean  @default(false)  // System groups can't be deleted
  sortOrder      Int      @default(0)

  organization   Organization @relation(fields: [organizationId], references: [id])
  parentGroup    AccountGroup?  @relation("AccountGroupHierarchy", fields: [parentGroupId], references: [id])
  childGroups    AccountGroup[] @relation("AccountGroupHierarchy")
  accounts       Account[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentGroupId])
}

model Account {
  id             String   @id @default(cuid())
  organizationId String
  groupId        String
  name           String
  nameNepali     String?
  code           String   // e.g. "11001", "21001"
  accountType    String   // "asset", "liability", "equity", "income", "expense"
  subType        String?  // "bank", "cash", "receivable", "payable", "vat", "tds", etc.
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  allowsDirectPosting Boolean @default(true)
  openingBalance Float    @default(0)
  currentBalance Float    @default(0)

  organization   Organization @relation(fields: [organizationId], references: [id])
  group          AccountGroup @relation(fields: [groupId], references: [id])
  journalLines   JournalEntryLine[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([groupId])
  @@index([accountType])
}

// ============================================================
// JOURNAL ENTRIES & DOUBLE-ENTRY BOOKKEEPING
// ============================================================

model JournalEntry {
  id              String   @id @default(cuid())
  organizationId  String
  fiscalYearId    String?
  entryNumber     String   // Auto-generated e.g. "JE-001"
  date            DateTime
  narration       String   // Description of the transaction
  voucherType     String   @default("journal") // "payment", "receipt", "journal", "contra", "sales", "purchase"
  referenceType   String?  // "invoice", "purchase_bill", "manual"
  referenceId     String?  // ID of the related document
  isPosted        Boolean  @default(true)
  isCancelled     Boolean  @default(false)
  totalDebit      Float    @default(0)
  totalCredit     Float    @default(0)
  createdBy       String?

  organization    Organization @relation(fields: [organizationId], references: [id])
  fiscalYear      FiscalYear?  @relation(fields: [fiscalYearId], references: [id])
  lines           JournalEntryLine[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, entryNumber])
  @@index([organizationId])
  @@index([date])
  @@index([voucherType])
  @@index([referenceType, referenceId])
}

model JournalEntryLine {
  id              String   @id @default(cuid())
  journalEntryId  String
  accountId       String
  debit           Float    @default(0)
  credit          Float    @default(0)
  narration       String?  // Line-level narration
  partyId         String?  // Optional party reference
  costCenter      String?  // For future use

  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account         Account      @relation(fields: [accountId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([journalEntryId])
  @@index([accountId])
  @@index([partyId])
}

// ============================================================
// PARTIES (CUSTOMERS, SUPPLIERS, EMPLOYEES)
// ============================================================

model Party {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  nameNepali     String?
  panNumber      String?   // PAN for IRD compliance
  partyType      String    // "customer", "supplier", "both", "employee"
  email          String?
  phone          String?
  address        String?
  city           String?
  province       String?
  contactPerson  String?
  creditLimit    Float?
  openingBalance Float     @default(0)
  balanceType    String?   // "debit" or "credit" - for opening balance
  currentBalance Float     @default(0)
  isTdsApplicable Boolean  @default(false)
  tdsCategory    String?   // TDS category: contract, rent, interest, commission, consultancy, transport, others
  tdsRate        Float?    // TDS rate for this party
  tdsPAN         String?
  isSSFAplicable Boolean  @default(false)
  bankName       String?
  bankAccount    String?
  isActive       Boolean  @default(true)
  notes          String?

  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([partyType])
}

// ============================================================
// PRODUCTS & INVENTORY
// ============================================================

model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  nameNepali     String?
  code           String?   // SKU/Product code
  unit           String?   // "pcs", "kg", "ltr", "box"
  hsnCode        String?   // HSN/SAC code for GST/VAT
  category       String?
  brand          String?
  productType    String    @default("goods") // "goods" or "service"
  isVatable      Boolean   @default(true)
  vatRate        Float?    // Override org default if set
  sellingPrice   Float?
  costPrice      Float?
  minStockLevel  Float?
  maxStockLevel  Float?
  costingMethod  String    @default("fifo") // "fifo", "weighted_average"
  hasBatch       Boolean   @default(false)
  hasExpiry      Boolean   @default(false)
  isActive       Boolean   @default(true)
  description    String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  stockLevels    StockLevel[]
  stockTransactions StockTransaction[]
  invoiceLines   InvoiceLine[]
  purchaseBillLines PurchaseBillLine[]
  creditNoteLines CreditNoteLine[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([code])
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  nameNepali     String?
  address        String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)

  organization   Organization @relation(fields: [organizationId], references: [id])
  stockLevels    StockLevel[]
  stockTransactions StockTransaction[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model StockLevel {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  warehouseId    String
  quantity       Float    @default(0)
  reservedQty    Float    @default(0)
  batchNumber    String?
  expiryDate     DateTime?
  costPrice      Float?   // Weighted average cost

  product        Product   @relation(fields: [productId], references: [id])
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, warehouseId, batchNumber])
  @@index([productId])
  @@index([warehouseId])
}

model StockTransaction {
  id              String   @id @default(cuid())
  organizationId  String
  productId       String
  warehouseId     String
  transactionType String   // "purchase", "sale", "adjustment", "transfer_in", "transfer_out", "return_in", "return_out"
  quantity        Float
  referenceType   String?  // "invoice", "purchase_bill", "adjustment"
  referenceId     String?
  batchNumber     String?
  expiryDate      DateTime?
  costPrice       Float?
  notes           String?

  product         Product   @relation(fields: [productId], references: [id])
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
}

// ============================================================
// SALES & INVOICING
// ============================================================

model Invoice {
  id              String   @id @default(cuid())
  organizationId  String
  invoiceNumber   String   // Auto-generated e.g. "INV-81/82-00001"
  fiscalYear      String?  // e.g. "2081/82"
  date            DateTime
  dateBS          String?  // e.g. "2081-05-27"
  transactionTime String?  // e.g. "14:30:15"
  dueDate         DateTime?
  partyId         String?
  invoiceType     String   @default("sales") // "sales", "sales_return", "abbreviated"
  status          String   @default("draft") // "draft", "issued", "sent", "paid", "partial", "overdue", "cancelled"
  paymentMode     String   @default("cash")  // "cash", "credit", "bank", "cheque", "digital"
  subtotal        Float    @default(0)
  discountAmount  Float    @default(0)
  taxableAmount   Float    @default(0)
  exemptAmount    Float    @default(0)       // Non-taxable / exempt sales (Schedule 1)
  vatAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  amountPaid      Float    @default(0)
  amountDue       Float    @default(0)
  tdsAmount       Float    @default(0)
  panNumber       String?  // Buyer PAN for IRD compliance
  buyerName       String?  // Buyer Name
  buyerAddress    String?  // Buyer Address
  billingAddress  String?
  shippingAddress String?
  notes           String?
  terms           String?
  journalEntryId  String?  // Link to auto-created journal entry

  // IRD Audit & Print Tracking
  printCount      Int      @default(0)       // 0 = unprinted, 1 = "कर बीजक", >1 = "कर बीजकको प्रतिलिपि"
  lastPrintedAt   DateTime?
  cancelReason    String?  // Mandatory reason for invoice cancellation under IRD
  cancelledAt     DateTime?
  cancelledBy     String?
  isRealtime      Boolean  @default(true)

  // CBMS Real-time Synchronization
  syncStatus      String   @default("pending") // "pending", "synced", "failed", "not_applicable"
  syncResponseCode Int?    // IRD CBMS response code (200=success, 100, 101, 102, 104)
  syncResponseMessage String?
  syncedAt        DateTime?
  syncAttempts    Int      @default(0)

  organization    Organization @relation(fields: [organizationId], references: [id])
  lines           InvoiceLine[]
  creditNotes     CreditNote[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([partyId])
  @@index([date])
  @@index([status])
  @@index([syncStatus])
}

model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  productId       String?
  description     String
  hsnCode         String?  // Harmonized System Code for IRD
  quantity        Float    @default(1)
  unit            String?
  unitPrice       Float    @default(0)
  discountPercent Float    @default(0)
  discountAmount  Float    @default(0)
  taxableAmount   Float    @default(0)
  isExempt        Boolean  @default(false)   // True if exempt from VAT
  vatRate         Float?
  vatAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  sortOrder       Int      @default(0)

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

// ============================================================
// SALES RETURN & CREDIT NOTES (क्रेडिट नोट)
// ============================================================

model CreditNote {
  id                  String   @id @default(cuid())
  organizationId      String
  creditNoteNumber    String   // Auto-generated e.g. "CN-81/82-00001"
  fiscalYear          String   // e.g. "2081/82"
  originalInvoiceId   String
  originalInvoiceNo   String   // Original bill reference
  date                DateTime
  dateBS              String?  // Bikram Sambat date e.g. "2081-05-27"
  partyId             String?
  partyName           String
  partyPan            String?
  reason              String   // Mandatory reason under IRD guidelines
  subtotal            Float    @default(0)
  taxableAmount       Float    @default(0)
  exemptAmount        Float    @default(0)
  vatAmount           Float    @default(0)
  totalAmount         Float    @default(0)
  paymentMode         String   @default("cash")

  // IRD Print Tracking
  printCount          Int      @default(0)
  lastPrintedAt       DateTime?

  // CBMS Sync (/api/billreturn)
  syncStatus          String   @default("pending") // "pending", "synced", "failed"
  syncResponseCode    Int?
  syncResponseMessage String?
  syncedAt            DateTime?
  syncAttempts        Int      @default(0)

  journalEntryId      String?  // Reversal journal entry

  organization        Organization @relation(fields: [organizationId], references: [id])
  invoice             Invoice      @relation(fields: [originalInvoiceId], references: [id])
  lines               CreditNoteLine[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId])
  @@index([originalInvoiceId])
  @@index([date])
  @@index([syncStatus])
}

model CreditNoteLine {
  id              String   @id @default(cuid())
  creditNoteId    String
  productId       String?
  description     String
  hsnCode         String?
  quantity        Float    @default(1)
  unit            String?
  unitPrice       Float    @default(0)
  taxableAmount   Float    @default(0)
  vatRate         Float?
  vatAmount       Float    @default(0)
  totalAmount     Float    @default(0)

  creditNote      CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product         Product?   @relation(fields: [productId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([creditNoteId])
  @@index([productId])
}

// ============================================================
// PURCHASE MANAGEMENT
// ============================================================

model PurchaseBill {
  id              String   @id @default(cuid())
  organizationId  String
  billNumber      String   // Auto-generated e.g. "PUR-001"
  supplierBillNo  String?  // Supplier's own bill number
  fiscalYear      String?  // e.g. "2081/82"
  date            DateTime
  dateBS          String?  // Bikram Sambat date
  dueDate         DateTime?
  partyId         String?
  billType        String   @default("purchase") // "purchase", "purchase_return"
  status          String   @default("draft") // "draft", "received", "paid", "partial", "cancelled"
  subtotal        Float    @default(0)
  discountAmount  Float    @default(0)
  taxableAmount   Float    @default(0)
  exemptAmount    Float    @default(0) // Exempt purchases (Annex 6)
  capitalAmount   Float    @default(0) // Capital goods purchases (Annex 6)
  vatAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  amountPaid      Float    @default(0)
  amountDue       Float    @default(0)
  tdsAmount       Float    @default(0)
  warehouseId     String?
  isImport        Boolean  @default(false) // Foreign import (Annex 6)
  pragyapanPatraNo String? // Customs Declaration Number / प्रज्ञापनपत्र नं
  country         String?  // Import Country
  notes           String?
  journalEntryId  String?

  organization    Organization @relation(fields: [organizationId], references: [id])
  lines           PurchaseBillLine[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, billNumber])
  @@index([organizationId])
  @@index([partyId])
  @@index([date])
  @@index([status])
}

model PurchaseBillLine {
  id              String   @id @default(cuid())
  purchaseBillId  String
  productId       String?
  description     String
  quantity        Float    @default(1)
  unit            String?
  unitPrice       Float    @default(0)
  discountPercent Float    @default(0)
  discountAmount  Float    @default(0)
  taxableAmount   Float    @default(0)
  vatRate         Float?
  vatAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  batchNumber     String?
  expiryDate      DateTime?
  sortOrder       Int      @default(0)

  purchaseBill    PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  product         Product?     @relation(fields: [productId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([purchaseBillId])
  @@index([productId])
}

// ============================================================
// CBMS AUDIT & TRANSMISSION LOGS
// ============================================================

model CbmsSyncLog {
  id              String   @id @default(cuid())
  organizationId  String
  billType        String   // "invoice" or "credit_note"
  billId          String
  billNumber      String
  endpoint        String
  requestPayload  String   // Serialized JSON payload sent to IRD
  responseCode    Int?     // HTTP or CBMS Status code (e.g. 200, 100, 101, 102, 104)
  responseBody    String?
  isSuccess       Boolean  @default(false)
  errorMessage    String?
  durationMs      Int?

  organization    Organization @relation(fields: [organizationId], references: [id])

  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([billId])
  @@index([createdAt])
}

// ============================================================
// TAX CONFIGURATION
// ============================================================

model TaxRate {
  id             String   @id @default(cuid())
  organizationId String
  name           String   // "VAT 13%", "TDS 1.5%", "SSF 31%"
  nameNepali     String?
  taxType        String   // "vat", "tds", "ssf", "custom"
  rate           Float
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  description    String?

  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([taxType])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String   // "create", "update", "delete", "cancel", "post", "print"
  module         String   // "journal", "invoice", "purchase", "inventory", "party", "account"
  recordId       String?
  recordType     String?
  details        String?  // JSON string with change details
  ipAddress      String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])

  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([module])
  @@index([createdAt])
}
